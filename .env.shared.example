# Shared Environment Configuration
# Copy this content to .env.shared (git-ignored) and adjust values for your setup.

# Application runtime
APP__ENVIRONMENT=dev
# APP__DEBUG=true

# PostgreSQL connection URL (required)
# Format: postgresql://user:password@host:port/database_name
DATABASE__URL=postgresql://your_user:your_password@localhost:5432/sales_bot

# S3 Storage (MinIO)
S3__ENDPOINT_URL=http://minio:9000
S3__ACCESS_KEY_ID=minioadmin
S3__SECRET_ACCESS_KEY=minioadmin
S3__BUCKET_NAME=sales-media

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional shared infrastructure
# REDIS__URL=redis://localhost:6379/0

# Backend service exposed to transports and connectors
BACKEND__URL=http://localhost:9000
SALES_AGENT__URL=http://localhost:8000

# CORS (optional; leave commented to disable)
# CORS__ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:5173"]
# CORS__ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
# CORS__ALLOW_HEADERS=["*"]
# CORS__ALLOW_CREDENTIALS=false
# CORS__EXPOSE_HEADERS=[]
# CORS__MAX_AGE=600

# Telegram transport module endpoint (used for all Telegram connectors)
# TRANSPORT__TELEGRAM__ENDPOINT=http://localhost:8081

# Langfuse telemetry (optional)
# LANGFUSE__ENABLED=true
# LANGFUSE__PUBLIC_KEY=pk-lf-...
# LANGFUSE__SECRET_KEY=sk-lf-...
# LANGFUSE__HOST=https://cloud.langfuse.com
# LANGFUSE__SAMPLE_RATE=1.0
# LANGFUSE__ENABLE_GENERATION_CALLBACK_ONLY=true

# LLM provider configuration (OpenAI-compatible APIs)
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=sk-your-openai-api-key-here
LLM__LIGHT_MODEL=gpt-4o-mini
LLM__LARGE_MODEL=gpt-4o

# Retrieval-Augmented Generation defaults
RAG__ENABLED=true
RAG__DEFAULT_KB=default

# Embeddings API
RAG__EMBEDDING__BASE_URL=https://your-embedding-api.example.com/v1
RAG__EMBEDDING__API_KEY=sk-your-embedding-api-key
RAG__EMBEDDING__MODEL=BAAI/bge-m3
RAG__EMBEDDING__DIMENSION=1024
RAG__EMBEDDING__TIMEOUT_S=30.0

# Qdrant vector store
RAG__QDRANT__URL=https://your-qdrant-cluster.example.com
RAG__QDRANT__API_KEY=your-qdrant-api-key
RAG__QDRANT__COLLECTION_PREFIX=kb
# RAG__QDRANT__PREFER_SPARSE=false

# Optional reranker API
RAG__RERANKER__ENABLED=false
# RAG__RERANKER__BASE_URL=https://your-reranker-api.example.com/v1
# RAG__RERANKER__API_KEY=sk-your-reranker-api-key
# RAG__RERANKER__MODEL=BAAI/bge-reranker-v2-m3
# RAG__RERANKER__TIMEOUT_S=30.0

# Chunking defaults for knowledge ingestion
RAG__CHUNK_MAX_TOKENS=800
RAG__CHUNK_OVERLAP_TOKENS=120

# Debounce suppression window shared across connectors
DEBOUNCE__WINDOW_SECONDS=45

# FAQ matching thresholds
FAQ__ENABLED=true
FAQ__THRESHOLD=0.82
# FAQ__USE_QDRANT=false
# FAQ__KB_NAME=faq
# FAQ__PATH=

# Humanizer toggle
HUMANIZER__ENABLED=true

# Optional Yandex integrations
# YANDEX__TOKEN=your-yandex-api-key

# Audio transcription service
AUDIO__API_KEY=sk-your-openai-api-key-for-transcription
AUDIO__MODEL=gpt-4o-mini-transcribe
# AUDIO__BASE_URL=https://api.openai.com/v1
AUDIO__MAX_AUDIO_BYTES=15000000
AUDIO__SUPPORTED_MIMES=["audio/ogg","audio/opus","audio/mpeg"]
AUDIO__TIMEOUT_S=60
AUDIO__TRANSCODE_ENABLED=true
AUDIO__FFMPEG_PATH=ffmpeg

# Traefik domain routing (server profile only)
# Only services with a non-empty DOMAIN_* will get HTTPS routes via Traefik.
# Comment out or leave empty to skip a service.
DOMAIN_BACKEND=backend.example.com
# DOMAIN_SALES=sales.example.com
# DOMAIN_CONNECTOR_HUB=connector.example.com
ACME_EMAIL=admin@example.com
