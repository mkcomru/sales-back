# Sales Agent Module Configuration
# Copy this file to .env for module-specific overrides.
# Shared defaults (LLM, telemetry, backend URL, RAG, FAQ, audio, debounce, etc.) live in .env.shared.

# Connector configuration (example: Bitrix CRM connector)
# CONNECTORS__BITRIX__TYPE=crm
# CONNECTORS__BITRIX__CHANNEL_TYPES__0=bitrix
# CONNECTORS__BITRIX__SECRETS__TOKEN=your-secret-token-here
# CONNECTORS__BITRIX__CALLBACKS__DELIVERY_URL=https://your-proxy.example.com/callback
# CONNECTORS__BITRIX__CALLBACKS__PROXY_URL=https://your-proxy.example.com
# CONNECTORS__BITRIX__DEBOUNCE__WINDOW_SECONDS=45
# CONNECTORS__BITRIX__TRANSPORT__ENABLED=true
# CONNECTORS__BITRIX__TRANSPORT__ENDPOINT=https://transport.example.com/bitrix
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__MAX_ATTEMPTS=3
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__BACKOFF_SCHEDULE_MS__0=1000
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__BACKOFF_SCHEDULE_MS__1=5000
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__BACKOFF_SCHEDULE_MS__2=15000
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__CONNECT_TIMEOUT_S=2.0
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__READ_TIMEOUT_S=6.0
# CONNECTORS__BITRIX__TRANSPORT__RETRIES__TOTAL_TIMEOUT_S=8.0

# Optional: enable per-connector metadata
# CONNECTORS__BITRIX__METADATA__region=ru
